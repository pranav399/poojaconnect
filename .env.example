# Copy to .env for local development. Keep real secrets out of source control.

# Server
PORT=3000
NODE_ENV=development

# Optional Gemini integration
GEMINI_API_KEY=

# Optional public app URL
APP_URL=http://localhost:3000

# Configure either SendGrid or SMTP for OTP email.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Mailtrap Email Sandbox (local testing)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL="PoojaConnect <from@example.com>"

# Firebase web config. Set these at build time because Vite embeds them in the frontend bundle.
VITE_FIREBASE_API_KEY=AIzaSyBQBcl8Q88u8eJXTPWQGcaWDkbzpzu0VYA
VITE_FIREBASE_AUTH_DOMAIN=poojaconnect-9935f.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=poojaconnect-9935f
VITE_FIREBASE_STORAGE_BUCKET=poojaconnect-9935f.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=859270354172
VITE_FIREBASE_APP_ID=1:859270354172:web:f85bad9bba47159100f379
